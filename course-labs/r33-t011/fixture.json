    {"record_id": "r2", "x1": 1, "x2": 1, "target": 3},
    {"record_id": "r3", "x1": 2, "x2": 1, "target": 5},
    {"record_id": "r4", "x1": 3, "x2": 1, "target": 7},
    {"record_id": "r5", "x1": 4, "x2": 1, "target": 9},
    {"record_id": "r6", "x1": 5, "x2": 1, "target": 11}
  ],
  "splits": {
    "train": ["r1", "r2", "r3", "r4"],
    "validation": ["r5"],
    "test": ["r6"]
  }
}
