{
  "fixture_type": "deterministic_formula_fixture",
  "description": "Synthetic data used only for pipeline verification.",
  "seed": 42,
  "formula": "target = 2 * x1 + 1",
  "schema": {
    "record_id": "non-empty unique string",
    "x1": "finite number",
